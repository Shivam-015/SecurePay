DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# Docker Compose uses PostgreSQL. For local SQLite, leave DB_ENGINE unset.
DB_ENGINE=postgresql
DB_NAME=securepay
DB_USER=securepay
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

CELERY_BROKER_URL=redis://redis:6379/0
DEADLINE_EMAILS=false
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=SecurePay <no-reply@localhost>
WEB_HOST_BIND=127.0.0.1
WEB_PORT=8000
